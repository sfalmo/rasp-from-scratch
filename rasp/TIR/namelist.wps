&share
 wrf_core             = 'ARW'
 max_dom              = 2,
 start_date           = '2014-02-22_03:00:00', '2014-02-22_03:00:00',
 end_date             = '2014-02-22_18:00:00', '2014-02-22_18:00:00',
 interval_seconds     = 10800,
 io_form_geogrid      = 2,
/

&geogrid
 parent_id            = 1,      1,
 parent_grid_ratio    = 1,      5,
 i_parent_start       = 1,      25,
 j_parent_start       = 1,      25,
 e_we                 = 104,    276,
 e_sn                 = 104,    276,
 geog_data_res        = 'gmted2010_30s+corine_usgs_500m+bnu_soil_30s+modis_fpar+modis_lai+2m+2.5m', 'SRTM+corine_usgs_250m+bnu_soil_30s+modis_fpar+modis_lai+30s+2m+2.5m',
 dx                   = 10000,
 dy                   = 10000,
 map_proj             = 'lambert',
 ref_lat              = 50.20,
 ref_lon              = 11.20,
 truelat1             = 49.20,
 truelat2             = 51.20,
 stand_lon            = 11.20,
 geog_data_path       = '/root/rasp/geog'
 opt_geogrid_tbl_path = '.'
/

&ungrib
 out_format           = 'WPS',
 prefix               = 'UNGRIB',
/

&metgrid
 opt_metgrid_tbl_path = '.'
 fg_name              = 'UNGRIB',
 constants_name       = 'TAVGSFC',
 io_form_metgrid      = 2,
/

